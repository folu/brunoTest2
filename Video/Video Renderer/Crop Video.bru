meta {
  name: Crop Video
  type: http
  seq: 1
}

post {
  url: http://videorenderer.playingsurface.net:32260/api/video/crop
  body: json
  auth: none
}

body:json {
  {
  	"uri": "https://playingsurface1.blob.core.windows.net/assets/toolkit/mattytest/mov_bbb.mp4",
  	"trim": {
  		"start": 5000,
  		"end": 10000
  	},
  	"crop": {
  		"width": 100,
  		"height": 100,
  		"x": 10,
  		"y": 50
  	},
  	"output": {
  		"width": 200,
  		"hegiht": 200
  	}
  }
  
}
