meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{api}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "email": "{{email}}",
      "password": "{{password}}"
  }
}

script:post-response {
  var data = JSON.parse(responseBody);
  bru.setEnvVar("token", data.auth_token);
  
  
  
  
  
}
