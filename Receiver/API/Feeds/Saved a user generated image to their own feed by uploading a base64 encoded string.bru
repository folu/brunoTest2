meta {
  name: Saved a user generated image to their own feed by uploading a base64 encoded string
  type: http
  seq: 2
}

post {
  url: {{receiver-api}}/Feeds/image
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: text/plain
}

body:json {
  {
    "projectId": 11920967,
    "base64ImageString": "aliqua anim dolor ipsum",
    "mimeType": "esse consectetur"
  }
}
