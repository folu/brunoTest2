meta {
  name: media
  type: http
  seq: 1
}

get {
  url: {{api}}/socialnetwork/hootsuite/v1/media
  body: none
  auth: oauth2
}

headers {
  ~Authorization: bearer {{token}}
  ~Content-Type: application/json
}

auth:oauth2 {
  grant_type: authorization_code
  callback_url: 
  authorization_url: 
  access_token_url: 
  refresh_token_url: 
  client_id: 
  client_secret: 
  scope: 
  state: 
  pkce: false
  credentials_placement: basic_auth_header
  credentials_id: 
  token_placement: header
  token_header_prefix: 
  auto_fetch_token: true
  auto_refresh_token: false
}
