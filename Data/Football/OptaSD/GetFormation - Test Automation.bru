meta {
  name: GetFormation - Test Automation
  type: http
  seq: 2
}

get {
  url: {{api}}/data/football/optasd/formation?eventId=g2292963&homeOrAway=home&leagueId=8&language=ar
  body: none
  auth: none
}

params:query {
  eventId: g2292963
  homeOrAway: home
  leagueId: 8
  language: ar
}

headers {
  x-api-key: {{apiKey}}
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  const schema = {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "coordinates": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
