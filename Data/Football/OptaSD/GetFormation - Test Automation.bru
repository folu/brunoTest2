          "required": ["x", "y"]
        },
        "playerKnownName": { "type": "string" },
        "playerLastName": { "type": "string" },
        "playerDisplayLastName": { "type": "string" },
        "matchName": { "type": "string" },
        "teamName": { "type": "string" },
        "teamId": { "type": "string" },
        "shirtNumber": { "type": "string" },
        "id": { "type": "string" },
        "position": { "type": "string" },
        "positionShortName": { "type": "string" },
        "generalPosition": { "type": "string" },
        "playerId": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "required": [
        "coordinates",
        "playerLastName",
        "playerDisplayLastName",
        "matchName",
        "teamName",
        "teamId",
        "shirtNumber",
        "id",
        "position",
        "positionShortName",
        "generalPosition",
        "playerId",
        "x",
        "y"
      ]
    }
  };
  
  test("Response matches schema", function () {
  //   pm.response.to.have.jsonSchema(schema);
