meta {
  name: GetMatchPenaltyHistory- Test Automation
  type: http
  seq: 20
}

get {
  url: {{api}}/data/football/opta/match/penaltyhistory?leagueId=24&seasonId=2024&playerId=p115382&eventId=g2448504&showSavedAttempts=true&penaltyCount=15&filterByCompetition=24|112|21|8|22|23|9|99|14|119|104|105|10|102|87|144|96
  body: none
  auth: none
}

params:query {
  leagueId: 24
  seasonId: 2024
  playerId: p115382
  eventId: g2448504
  showSavedAttempts: true
  penaltyCount: 15
  filterByCompetition: 24|112|21|8|22|23|9|99|14|119|104|105|10|102|87|144|96
  ~teamId: t43
}

headers {
  x-api-key: {{apiKey}}
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response time is less than 3000ms", function () {
      expect(res.getResponseTime()).to.be.below(3000);
  });
  
  const schema = {
      "type": "object",
      "properties": {
          "player": {
              "type": "object",
              "properties": {
                  "id": { "type": "string" },
                  "fullName": { "type": "string" },
                  "captainText": { "type": "string" }
              },
              "required": ["id", "fullName", "captainText"]
          },
          "penalties": {
              "type": "array",
              "items": {
                  "type": "object",
                  "properties": {
                      "outcome": { "type": "integer" },
                      "outcomeStr": { "type": "string" },
                      "goalMouthY": { "type": "number" },
                      "goalMouthZ": { "type": "number" },
                      "time": {
                          "type": "object",
                          "properties": {
                              "minutes": { "type": "integer" },
                              "seconds": { "type": "integer" }
                          },
                          "required": ["minutes", "seconds"]
                      },
                      "description": { "type": "string" }
                  },
                  "required": ["outcome", "outcomeStr", "goalMouthY", "goalMouthZ", "time", "description"]
              }
          }
      },
      "required": ["player", "penalties"]
  };
  
  test("Schema is valid", function () {
      const response = res.getBody();
      expect(tv4.validate(response, schema)).to.be.true;
  });
  
  test("All penalties have required properties", function () {
      const penalties = res.getBody().penalties;
  
      penalties.forEach((penalty, index) => {
          expect(penalty).to.have.property("outcome").that.is.a("number");
          expect(penalty).to.have.property("outcomeStr").that.is.a("string");
          expect(penalty).to.have.property("goalMouthY").that.is.a("number");
          expect(penalty).to.have.property("goalMouthZ").that.is.a("number");
          expect(penalty).to.have.property("description").that.is.a("string");
          expect(penalty).to.have.property("time").that.is.an("object");
  
          expect(penalty.time).to.have.property("minutes").that.is.a("number");
          expect(penalty.time).to.have.property("seconds").that.is.a("number");
      });
  });
  
  const requestedCount = 15; // Requested penalty count
  const penalties = res.getBody().penalties;
  
  test("Penalties count matches available data (up to requested value)", function () {
      expect(penalties.length).to.be.at.most(requestedCount, "Penalties count exceeds requested value");
      console.log(`Penalties count returned: ${penalties.length} (Requested: ${requestedCount})`);
  });
  
  
  
  
  
  
}
