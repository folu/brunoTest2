meta {
  name: GetTeamMatchRadarStats
  type: http
  seq: 32
}

get {
  url: {{api}}/data/football/opta/team/matchstats/radar?leagueId=8&seasonId=2019&eventId=g1059811
  body: none
  auth: none
}

params:query {
  leagueId: 8
  seasonId: 2019
