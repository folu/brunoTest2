meta {
  name: GetMatchPlayerIndex - Test Automation Copy
  type: http
  seq: 7
}

get {
  url: {{api}}/data/rugbyunion/opta/match/playerindex?matchId=945053,945051,945052,945048,945049,945050&numberOfPlayers=5&positionId=3
  body: none
  auth: none
}

params:query {
  matchId: 945053,945051,945052,945048,945049,945050
  numberOfPlayers: 5
  positionId: 3
  ~seasonId: 
  ~eventId: 
  ~positionId: 6
  ~categoryId: offensiveindex
  ~teamId: 19568
}

headers {
  x-api-key: {{apiKey}}
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has correct structure", function () {
      var response = res.getBody();
      expect(response).to.be.an('array');
  
      // structure checks
      response.forEach((entry) => {
          // check player structure
          expect(entry).to.have.property('player');
          expect(entry.player).to.have.all.keys('id', 'firstName', 'lastName', 'fullName', 'position', 'teamId', 'captainText');
  
          // team structure
          expect(entry).to.have.property('team');
          expect(entry.team).to.have.all.keys('id', 'pbgId', 'name', 'crest', 'crestName');
  
          //match and stats
          expect(entry).to.have.property('matchId');
          expect(entry).to.have.property('stat');
          expect(entry).to.have.property('optaRank');
          expect(entry).to.have.property('optaRankOrdinal');
      });
  });
  
  test("Player and team IDs are unique and correctly formatted", function () {
      let players = {};
      let teams = {};
      var response = res.getBody();
  
      response.forEach((entry) => {
          // Check player ID uniqueness
          if (players[entry.player.id]) {
              expect.fail("Duplicate player ID found: " + entry.player.id);
          } else {
              players[entry.player.id] = true;
              expect(entry.player.id).to.match(/^\d+$/, "Player ID should be numeric");
          }
  
          // Check team ID uniqueness and format
          if (teams[entry.team.id]) {
              expect.fail("Duplicate team ID found: " + entry.team.id);
          } else {
              teams[entry.team.id] = true;
              expect(entry.team.id).to.match(/^\d+$/, "Team ID should be numeric");
          }
      });
  });
  
  // check that only players with positionId 3 are returned
  test("Only players with position 3 are returned", function () {
      let jsonData = res.getBody();
      jsonData.forEach(playerObj => {
          expect(playerObj.player.position).to.eql("tighthead prop"); 
      });
  });
  
  
  test("Players list is not empty", function () {
      let jsonData = res.getBody();
      expect(jsonData.length).to.be.above(0);
  });
  
  
  test("All players have valid names", function () {
      let jsonData = res.getBody();
      jsonData.forEach(playerObj => {
          expect(playerObj.player.fullName).to.not.be.empty;
      });
  });
  
  // each player has a valid optaRank
  test("All players have a valid optaRank", function () {
      let jsonData = res.getBody();
      jsonData.forEach(playerObj => {
          expect(playerObj.optaRank).to.match(/^\d+$/); 
      });
  });
  
  // check if the position rank is ordered correctly 
  test("Position rank values are ordered correctly", function () {
      let jsonData = res.getBody();
      let sortedRanks = jsonData.map(p => parseInt(p.positionRank)).sort((a, b) => a - b);
      let originalRanks = jsonData.map(p => parseInt(p.positionRank));
      
      expect(originalRanks).to.eql(sortedRanks);
  });
  
  // verify that only the requested position ID is returned
  //mapping of position
  const positionMap = {
      "tighthead prop": "3",
      "loosehead prop": "1",
      "hooker": "2",
      "lock": "4",
      "flanker": "6",
      "number eight": "8",
      "scrum-half": "9",
      "fly-half": "10",
      "centre": "12",
      "wing": "14",
      "full-back": "15"
  };
  
  test("No other positions appear in response", function () {
      let jsonData = res.getBody();
      let requestedPositionId = req.getUrl().query.get("positionId");
  
      jsonData.forEach(playerObj => {
          let actualPositionId = positionMap[playerObj.player.position];
          expect(actualPositionId).to.eql(requestedPositionId);
      });
  });
  
  
  
  
}
