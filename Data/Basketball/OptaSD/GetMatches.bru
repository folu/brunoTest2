meta {
  name: GetMatches
  type: http
  seq: 1
}

get {
  url: {{api}}/data/basketball/optasd/matches?tournamentId=nba&startDate=2019-10-10&groupByDate=true
  body: none
  auth: none
}

params:query {
  tournamentId: nba
  startDate: 2019-10-10
  groupByDate: true
  ~endDate: 2019-10-16
}

headers {
  x-api-key: {{apiKey}}
}
