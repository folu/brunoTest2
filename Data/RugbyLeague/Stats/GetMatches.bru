meta {
  name: GetMatches
  type: http
  seq: 2
}

get {
  url: {{api}}/data/rugbyleague/stats/matches?tournamentId=111&seasonId=2023
  body: none
  auth: none
}

params:query {
  tournamentId: 111
  seasonId: 2023
  ~groupbydate: true
